<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Qinmo Ultimate Launcher · 测试工程
    目的：承载"领域层纯单元测试"与"启动计划骨架一致性回归"（v1.2 文档第 7 节、决策 7）。
    测试工程不随主程序分发，其依赖不计入产品体积预算。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QinmoUltimateLauncher\QinmoUltimateLauncher.csproj" />
  </ItemGroup>

  <!-- 解压安全用例需要真实构造 zip；net48 的 SDK 风格工程不会自动带上压缩程序集。 -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <!--
    黄金样本随测试输出一起复制，测试因此离线可跑。
    用 Update 而不是 Include：SDK 默认 glob 已经收录了这些文件，再 Include 会触发重复项错误。
  -->
  <ItemGroup>
    <None Update="Golden\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
