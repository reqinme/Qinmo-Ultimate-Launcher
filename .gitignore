# 构建产物（启动器仓库的大头，检索与统计一律排除）
bin/
obj/
publish/
artifacts/

# 构建日志（一律落盘只读尾部，不入库）
*.log
build.log
sln-add.log
scaffold.log

# IDE
.vs/
*.user
*.suo
*.userprefs

# 设计期生成物
*.g.cs
*.g.i.cs

# 本地临时
*.tmp
.tmp/

publish-*/

# 本机参考用的第三方源码，不入库
repos/

# 构建产物目录：**任何**用于 -o 的目录名都要覆盖。
# 踩过的坑：规则里原本只有 publish/ 与 publish-*/，
# 而我一次验证里用了 pub-v1 / pub-v2，两个 315 KB 的 exe 就被提交了进去。
# 所以这里放宽到 pub*，宁可多忽略也不要再漏。
pub*/
pub-*/
