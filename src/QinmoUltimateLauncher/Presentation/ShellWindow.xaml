<Window x:Class="Qul.Presentation.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diag="clr-namespace:Qul.Application.Diagnostics"
        xmlns:pres="clr-namespace:Qul.Presentation"
        Title="Qinmo Ultimate Launcher"
        Height="820" Width="1120" MinHeight="560" MinWidth="760"
        FontFamily="{StaticResource Qul.Font.Family}" FontSize="{StaticResource Qul.Size.Font.Body}"
        Background="{DynamicResource Qul.Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <pres:InverseBooleanConverter x:Key="InverseBool" />

        <!-- 预检条目：严重度决定配色 -->
        <DataTemplate x:Key="PreflightTemplate" DataType="{x:Type diag:PreflightItem}">
            <Border x:Name="Card" Style="{StaticResource Qul.Style.Card.Status}">
                <StackPanel>
                    <TextBlock x:Name="Headline" Text="{Binding Title}"
                               FontWeight="SemiBold" FontSize="{StaticResource Qul.Size.Font.Body}"
                               Foreground="{DynamicResource Qul.Brush.Text.Primary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,4,0,0"
                               FontSize="{StaticResource Qul.Size.Font.Caption}"
                               Foreground="{DynamicResource Qul.Brush.Text.Secondary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:PreflightSeverity.Blocking}">
                    <Setter TargetName="Card" Property="Style" Value="{StaticResource Qul.Style.Card.Status.Danger}" />
                    <Setter TargetName="Headline" Property="Foreground" Value="{DynamicResource Qul.Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:PreflightSeverity.Warning}">
                    <Setter TargetName="Card" Property="Style" Value="{StaticResource Qul.Style.Card.Status.Warning}" />
                    <Setter TargetName="Headline" Property="Foreground" Value="{DynamicResource Qul.Brush.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 阶段格：未开始 / 进行中 / 已完成 / 失败 -->
        <DataTemplate x:Key="StageTemplate" DataType="{x:Type pres:StageVm}">
            <Border x:Name="Chip" CornerRadius="{StaticResource Qul.Radius.Pill}" Padding="10,3" Margin="0,0,6,0"
                    Background="{DynamicResource Qul.Brush.Surface.Inset}">
                <TextBlock x:Name="Label" Text="{Binding Title}"
                           FontSize="{StaticResource Qul.Size.Font.Caption}"
                           Foreground="{DynamicResource Qul.Brush.Text.Tertiary}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Qul.Brush.Accent.Subtle}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Qul.Brush.Accent}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Qul.Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static pres:StageState.Failed}">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Qul.Brush.Surface.Danger}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Qul.Brush.Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{StaticResource Qul.Thickness.Window}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 品牌 / 状态区 ================= -->
        <Grid Grid.Row="0" Margin="{StaticResource Qul.Thickness.SectionGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Qul.Icon.Brand}" Style="{StaticResource Qul.Style.Icon}"
                      Stroke="{DynamicResource Qul.Brush.Accent}" Width="26" Height="26" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Qinmo Ultimate Launcher" Style="{StaticResource Qul.Style.Text.Title}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Qul.Style.Text.Hint}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Qul.Style.Button.Text}" TabIndex="10" Command="{Binding ThemeCommand}"
                        AutomationProperties.Name="切换主题"
                        ToolTip="在 深色 / 浅色 / 跟随系统 之间切换">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding ThemeIcon}" Style="{StaticResource Qul.Style.Icon.Small}"
                              Stroke="{DynamicResource Qul.Brush.Text.Secondary}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Qul.Style.Button.Text}" Margin="4,0,0,0"
                        TabIndex="11" Command="{Binding OpenDataFolderCommand}" AutomationProperties.Name="打开数据目录">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Qul.Icon.Folder}" Style="{StaticResource Qul.Style.Icon.Small}"
                              Stroke="{DynamicResource Qul.Brush.Text.Secondary}" Margin="0,0,6,0" />
                        <TextBlock Text="数据目录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Qul.Style.Button.Text}" Margin="4,0,0,0"
                        Command="{Binding CheckUpdateCommand}"
                        IsEnabled="{Binding UpdateSourceConfigured}"
                        ToolTip="{Binding UpdateSourceHint}"
                        AutomationProperties.Name="检查更新">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Qul.Icon.Refresh}" Style="{StaticResource Qul.Style.Icon.Small}"
                              Stroke="{DynamicResource Qul.Brush.Text.Secondary}" Margin="0,0,6,0" />
                        <TextBlock Text="检查更新" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="{StaticResource Qul.Size.Gutter}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：配置卡片 -->
            <Border Grid.Column="0" Style="{StaticResource Qul.Style.Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="版本" Style="{StaticResource Qul.Style.Text.FieldLabel}" />
                    <Grid Margin="{StaticResource Qul.Thickness.FieldBlock}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Versions}"
                                  TabIndex="20" SelectedItem="{Binding SelectedVersion}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                  AutomationProperties.Name="游戏版本">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <!-- 不给这个，917 个版本在屏幕阅读器里全都叫
                                         "Qul.Domain.Metadata.VersionSummary"，完全无法区分。
                                         列表项的 automation 名称取自数据的 ToString()，
                                         ItemTemplate 里的文字不会自动成为名称。 -->
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Id}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Qul.Style.Button.Icon}"
                                TabIndex="21" Command="{Binding RefreshCommand}" AutomationProperties.Name="刷新版本清单"
                                ToolTip="重新读取版本清单">
                            <Path Data="{StaticResource Qul.Icon.Refresh}" Style="{StaticResource Qul.Style.Icon}"
                                  Stroke="{DynamicResource Qul.Brush.Text.Secondary}" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <TextBlock Text="身份来源" Style="{StaticResource Qul.Style.Text.FieldLabel}" />
                    <ComboBox Margin="{StaticResource Qul.Thickness.FieldBlock}"
                              ItemsSource="{Binding IdentityOptions}"
                              TabIndex="22" SelectedItem="{Binding SelectedIdentity}"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                              AutomationProperties.Name="身份来源"
                              AutomationProperties.HelpText="离线账户无法进入正版验证服务器">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Qul.Brush.Text.Tertiary}"
                                               FontSize="{StaticResource Qul.Size.Font.Caption}"
                                               TextWrapping="Wrap" MaxWidth="280" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="离线账户名" Style="{StaticResource Qul.Style.Text.FieldLabel}" />
                    <TextBox TabIndex="23" Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="离线账户名"
                             AutomationProperties.HelpText="仅作本地标识，与官方账号无关" />
                    <TextBlock Text="仅作本地标识，与官方账号无关。" Style="{StaticResource Qul.Style.Text.Hint}" />

                    <TextBlock Text="目标服务器（可留空）" Style="{StaticResource Qul.Style.Text.FieldLabel}" Margin="0,16,0,4" />
                    <TextBox TabIndex="24" Text="{Binding ServerTarget, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="目标服务器"
                             AutomationProperties.HelpText="留空时不会产生任何服务器相关结论" />
                    <TextBlock Style="{StaticResource Qul.Style.Text.Hint}"
                               Text="留空即代表你没有指定目标——此时不会产生任何服务器相关结论。" />
                </StackPanel>
            </Border>

            <!-- 右：预检 / 进度 / 日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- 有可用更新时才出现。主操作按钮突出，与「启动」同为 Filled 层级。 -->
                    <Border Style="{StaticResource Qul.Style.Card.Status.Info}" Margin="0,0,0,12"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding UpdateMessage}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Qul.Brush.Text.Primary}"
                                       TextWrapping="Wrap" AutomationProperties.Name="更新提示" />
                            <TextBlock Text="更新过程只替换主程序本身，不会触碰你的配置、存档与缓存。"
                                       Style="{StaticResource Qul.Style.Text.Hint}" />
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource Qul.Style.Button.Primary}"
                                    Command="{Binding ApplyUpdateCommand}"
                                    AutomationProperties.Name="立即更新并重启"
                                    Content="立即更新并重启" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="启动前预检" Style="{StaticResource Qul.Style.Text.Subtitle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Qul.Style.Button.Text}"
                                TabIndex="30" Command="{Binding RecheckCommand}" Content="重新检查"
                                AutomationProperties.Name="重新检查" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Preflight}" ItemTemplate="{StaticResource PreflightTemplate}" />

                    <!-- 能力告知的确认。没有它「启动」就不可用——这不是装饰。 -->
                    <Border Style="{StaticResource Qul.Style.Card.Status.Warning}" Margin="0,4,0,0"
                            Visibility="{Binding NeedsAcknowledgement, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox TabIndex="31" IsChecked="{Binding AcknowledgementGiven}"
                                  Content="我已了解上述限制，仍要继续启动。"
                                  AutomationProperties.Name="确认已知晓身份来源的能力限制" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource StageTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- RangeBase.Value 默认是 TwoWay，而 ProgressValue 只有私有 setter，必须显式 OneWay -->
                    <ProgressBar Margin="0,10,0,0" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 AutomationProperties.Name="启动进度" />

                    <!-- 冷装可能要走十几分钟，这一行是用户判断"该不该继续等"的唯一依据。
                         刻意**不设** AutomationProperties.Name：TextBlock 的可访问名称默认就是它的文本，
                         设成固定文案会让屏幕阅读器永远念"下载速度与剩余时间"而念不出真正的速度。
                         LiveSetting=Polite 让它在变化时被播报，但不抢焦点。 -->
                    <TextBlock Margin="0,6,0,0" Text="{Binding ProgressDetail}"
                               Foreground="{DynamicResource Qul.Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />

                    <Border Style="{StaticResource Qul.Style.Card.Status.Danger}" Margin="0,12,0,0"
                            Visibility="{Binding HasStartupNotice, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding StartupNotice}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Qul.Brush.Danger}" TextWrapping="Wrap"
                                       AutomationProperties.Name="启动提示"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource Qul.Style.Button.Text}"
                                    Command="{Binding DismissStartupNoticeCommand}"
                                    AutomationProperties.Name="知道了">
                                <TextBlock Text="知道了" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Qul.Style.Card.Status.Danger}" Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ErrorBanner}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Qul.Brush.Danger}" TextWrapping="Wrap"
                                       AutomationProperties.Name="错误信息" />
                            <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource Qul.Style.Button.Text}"
                                    Command="{Binding CopyDiagnosticsCommand}"
                                    AutomationProperties.Name="复制诊断信息">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Qul.Icon.Copy}" Style="{StaticResource Qul.Style.Icon.Small}"
                                          Stroke="{DynamicResource Qul.Brush.Text.Secondary}" Margin="0,0,6,0" />
                                    <TextBlock Text="复制诊断信息" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ResultSummary}" Margin="0,10,0,0"
                               Style="{StaticResource Qul.Style.Text.Secondary}" />
                </StackPanel>

                <Expander Grid.Row="2" Margin="0,12,0,0" TabIndex="40" IsExpanded="True" Header="运行日志"
                          Foreground="{DynamicResource Qul.Brush.Text.Secondary}"
                          AutomationProperties.Name="运行日志">
                    <ListBox x:Name="LogList" TabIndex="41" MinHeight="120" Margin="0,8,0,0"
                             ItemsSource="{Binding LogLines}"
                             Background="{DynamicResource Qul.Brush.Surface.Inset}"
                             BorderBrush="{DynamicResource Qul.Brush.Stroke.Subtle}" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="OnLogScrollChanged"
                             AutomationProperties.Name="日志内容">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,1" />
                                <!-- 不设这个，读屏会把每一项念成 "Qul.Presentation.LogLine"（数据类型的名字）。
                                     列表项的 automation 名称默认取自内容的 ToString()，
                                     而 DataTemplate 里的 TextBlock 并不会自动成为容器的名称。 -->
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background"
                                                            Value="{DynamicResource Qul.Brush.Accent.Subtle}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           FontFamily="{StaticResource Qul.Font.Mono}"
                                           FontSize="{StaticResource Qul.Size.Font.Mono}"
                                           Foreground="{DynamicResource Qul.Brush.Text.Secondary}"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </Grid>
        </Grid>

        <!-- ================= 底部操作条 ================= -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0"
                       Text="{Binding CurrentStageText, StringFormat=当前阶段：{0}}"
                       Style="{StaticResource Qul.Style.Text.Hint}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" TabIndex="50" Command="{Binding CopyDiagnosticsCommand}"
                        AutomationProperties.Name="复制诊断信息" Content="复制诊断信息" />
                <Button Margin="0,0,8,0" TabIndex="51" Command="{Binding CancelCommand}"
                        AutomationProperties.Name="取消" Content="取消" />
                <Button Style="{StaticResource Qul.Style.Button.Primary}" TabIndex="52" Command="{Binding LaunchCommand}"
                        AutomationProperties.Name="启动游戏"
                        AutomationProperties.HelpText="需要先确认身份来源的能力限制">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Qul.Icon.Play}" Fill="{DynamicResource Qul.Brush.Text.OnAccent}"
                              Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="启动" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
