<Window x:Class="Qul.Presentation.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diag="clr-namespace:Qul.Application.Diagnostics"
        xmlns:local="clr-namespace:Qul.Presentation"
        Title="Qinmo Ultimate Launcher"
        Height="760" Width="1080" MinHeight="580" MinWidth="900"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Background="#F5F6F8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="InverseBool" />

        <!-- 预检条目：严重度决定配色。阻断是红的，警告是琥珀色，提示是灰的。 -->
        <DataTemplate x:Key="PreflightTemplate" DataType="{x:Type diag:PreflightItem}">
            <Border x:Name="Card" Margin="0,0,0,6" Padding="10,8" CornerRadius="4"
                    Background="#FFFFFF" BorderBrush="#DDDFE4" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="Headline" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" Foreground="#5A6070" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:PreflightSeverity.Blocking}">
                    <Setter TargetName="Card" Property="Background" Value="#FDECEA" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#E08A80" />
                    <Setter TargetName="Headline" Property="Foreground" Value="#A5271B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:PreflightSeverity.Warning}">
                    <Setter TargetName="Card" Property="Background" Value="#FFF8E6" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#E6C973" />
                    <Setter TargetName="Headline" Property="Foreground" Value="#8A6100" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：状态 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Qinmo Ultimate Launcher" FontSize="19" FontWeight="SemiBold" Foreground="#23262E" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="#5A6070" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：设置 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DDDFE4" BorderThickness="1" CornerRadius="4" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="版本" FontWeight="SemiBold" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Versions}"
                                      DisplayMemberPath="Id"
                                      SelectedItem="{Binding SelectedVersion}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Grid.Column="1" Content="刷新" Margin="6,0,0,0" Padding="10,3"
                                    Command="{Binding RefreshCommand}" />
                        </Grid>

                        <TextBlock Text="身份来源" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding IdentityOptions}"
                                  SelectedItem="{Binding SelectedIdentity}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#7A8090"
                                                   FontSize="11" TextWrapping="Wrap" MaxWidth="300" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="离线账户名" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox Margin="0,4,0,0" Padding="4,3" Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="仅作本地标识，与官方账号无关。" Foreground="#7A8090" FontSize="11" Margin="0,3,0,0" />

                        <TextBlock Text="目标服务器（可留空）" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBox Margin="0,4,0,0" Padding="4,3" Text="{Binding ServerTarget, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="留空即代表你没有指定目标——此时不会产生任何服务器相关结论。"
                                   Foreground="#7A8090" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />

                        <Button Content="打开数据目录" Margin="0,18,0,0" Padding="10,4" HorizontalAlignment="Left"
                                Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右栏：预检 / 结果 / 日志 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="启动前预检" FontWeight="SemiBold" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Preflight}"
                                  ItemTemplate="{StaticResource PreflightTemplate}" />

                    <!-- 能力告知的确认。没有它就不能启动——这不是装饰。 -->
                    <Border Background="#FFF8E6" BorderBrush="#E6C973" BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,4,0,0"
                            Visibility="{Binding NeedsAcknowledgement, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsChecked="{Binding AcknowledgementGiven}"
                                  Content="我已了解上述限制，仍要继续启动。" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <ProgressBar Height="6" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Border Background="#FDECEA" BorderBrush="#E08A80" BorderThickness="1" CornerRadius="4"
                            Padding="10,8" Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorBanner}" Foreground="#A5271B" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{Binding ResultSummary}" Margin="0,8,0,0" Foreground="#3C4250" TextWrapping="Wrap" />
                </StackPanel>

                <Expander Grid.Row="2" Header="日志" Margin="0,10,0,0" IsExpanded="True"
                          VerticalAlignment="Stretch">
                    <TextBox x:Name="LogBox" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                             Background="#FFFFFF" BorderBrush="#DDDFE4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding LogText, Mode=OneWay}"
                             TextChanged="OnLogTextChanged" />
                </Expander>
            </Grid>
        </Grid>

        <!-- 底部：按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="复制诊断信息" Padding="14,6" Margin="0,0,8,0"
                    Command="{Binding CopyDiagnosticsCommand}"
                    ToolTip="复制一份已脱敏的诊断报告：错误码、预检结果、日志尾部与复现步骤。" />
            <Button Content="取消" Padding="14,6" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="启动" Padding="26,6" FontWeight="SemiBold" Command="{Binding LaunchCommand}" />
        </StackPanel>
    </Grid>
</Window>
