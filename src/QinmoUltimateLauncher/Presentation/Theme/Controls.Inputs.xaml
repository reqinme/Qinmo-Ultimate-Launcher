<!--
    Qul 输入控件模板：TextBox / CheckBox / ComboBox / ScrollBar / ProgressBar

    调色板刻意**不在这里合并**：主题切换要求全局只有一个调色板实例，
    否则换主题时会出现"一半变了、一半没变"。
    这里只合并 Tokens（纯值类型，重复合并无害），且只用于 StaticResource 的尺寸与时长。
    所有画刷一律走 DynamicResource。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:qul="clr-namespace:Qul.Presentation">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QinmoUltimateLauncher;component/Presentation/Theme/Tokens.xaml" />
        <!-- Icons 与主题无关（纯几何），重复合并无害。
             这里必须自己合并：模板里的 {StaticResource Qul.Icon.*} 在解析期就要解析出来，
             指望上层合并是不够的。 -->
        <ResourceDictionary Source="/QinmoUltimateLauncher;component/Presentation/Theme/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================== TextBox ================== -->
    <ControlTemplate x:Key="Qul.Template.TextBox" TargetType="TextBox">
        <Grid>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Qul.Radius.Small}" />
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Qul.Brush.Stroke.Focus}"
                    BorderThickness="{StaticResource Qul.Stroke.Focus}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0" IsHitTestVisible="False" />
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
                <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Padding" Value="{StaticResource Qul.Thickness.Input}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Qul.Brush.Accent}" />
        <Setter Property="Template" Value="{StaticResource Qul.Template.TextBox}" />
    </Style>

    <!-- 只读日志用：无描边、内嵌底，视觉上明确"这不是输入框" -->
    <Style x:Key="Qul.Style.TextBox.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Mono}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ================== ScrollBar（细，无箭头） ================== -->
    <Style x:Key="Qul.Style.ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Qul.Brush.Stroke.Strong}"
                            CornerRadius="{StaticResource Qul.Radius.Pill}" Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Qul.Brush.Text.Tertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Qul.Style.ScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================== CheckBox ================== -->
    <ControlTemplate x:Key="Qul.Template.CheckBox" TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0">
                <Border x:Name="Box"
                        Background="{DynamicResource Qul.Brush.Surface.Inset}"
                        BorderBrush="{DynamicResource Qul.Brush.Stroke.Strong}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Qul.Radius.Small}" />
                <Border x:Name="FocusRing"
                        BorderBrush="{DynamicResource Qul.Brush.Stroke.Focus}"
                        BorderThickness="{StaticResource Qul.Stroke.Focus}"
                        CornerRadius="{StaticResource Qul.Radius.Small}"
                        Opacity="0" IsHitTestVisible="False" />
                <Path x:Name="Mark" Data="{StaticResource Qul.Icon.Check}"
                      Stroke="{DynamicResource Qul.Brush.Text.OnAccent}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="11" Height="11" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
            </Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Qul.Brush.Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Qul.Brush.Accent}" />
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Qul.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Disabled}" />
                <Setter TargetName="Box" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Qul.Template.CheckBox}" />
    </Style>

    <!-- ================== ComboBoxItem ================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Qul.Brush.Accent.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================== ComboBox ================== -->
    <ControlTemplate x:Key="Qul.Template.ComboBox" TargetType="ComboBox">
        <Grid>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Qul.Radius.Small}" />

            <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="SelectionSite" Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                  IsHitTestVisible="False"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                <Path Grid.Column="1" Data="{StaticResource Qul.Icon.ChevronDown}"
                      Stroke="{DynamicResource Qul.Brush.Text.Tertiary}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="12" Height="12" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Qul.Brush.Stroke.Focus}"
                    BorderThickness="{StaticResource Qul.Stroke.Focus}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0" IsHitTestVisible="False" />

            <!-- 透明 Toggle 铺满整块，点哪儿都能展开 -->
            <ToggleButton x:Name="DropDownToggle"
                          Background="Transparent" BorderThickness="0"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                   PopupAnimation="None" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Margin="0,4,0,0"
                        Background="{DynamicResource Qul.Brush.Surface.Overlay}"
                        BorderBrush="{DynamicResource Qul.Brush.Stroke.Subtle}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Qul.Radius.Small}"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Strong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Padding" Value="{StaticResource Qul.Thickness.Input}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template" Value="{StaticResource Qul.Template.ComboBox}" />
    </Style>

    <!-- ================== ProgressBar ==================
         不确定态用整条的不透明度脉动，而不是位移扫描：
         脉动是合成器层面的事，几乎不要钱；位移会触发重绘。
         这是规范里"持续动画"的唯一例外（加载指示）。 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Qul.Size.ProgressBarHeight}" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="Track" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Qul.Radius.Pill}" />
                        <Border x:Name="Fill" Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Qul.Radius.Pill}"
                                HorizontalAlignment="Left" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="False">
                            <Setter TargetName="Fill" Property="Width"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Fill" Property="Width"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard RepeatBehavior="{qul:MotionRepeat}" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity"
                                                         From="0.35" To="0.85" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
