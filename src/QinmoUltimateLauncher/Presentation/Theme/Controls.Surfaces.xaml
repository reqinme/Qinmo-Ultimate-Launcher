<!--
    Qul 表面与排版：卡片 / 分割线 / 文本层级 / 提示条 / 徽标
    同样只合并 Tokens，画刷一律 DynamicResource。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QinmoUltimateLauncher;component/Presentation/Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================== 文本层级 ================== -->
    <Style x:Key="Qul.Style.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Qul.Style.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Qul.Style.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Qul.Style.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 表单字段标签 -->
    <Style x:Key="Qul.Style.Text.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Qul.Style.Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="{StaticResource Qul.Thickness.FieldLabel}" />
    </Style>

    <!-- 辅助说明：低对比，不抢注意力 -->
    <Style x:Key="Qul.Style.Text.Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Qul.Style.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Qul.Style.Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="Qul.Style.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Secondary}" />
    </Style>

    <!-- ================== 卡片 ================== -->
    <Style x:Key="Qul.Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Qul.Radius.Medium}" />
        <Setter Property="Padding" Value="{StaticResource Qul.Thickness.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 预检条目的卡片：按严重度换配色，由使用点的 Tag 决定 -->
    <Style x:Key="Qul.Style.Card.Status" TargetType="Border" BasedOn="{StaticResource Qul.Style.Card}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Qul.Style.Card.Status.Info" TargetType="Border" BasedOn="{StaticResource Qul.Style.Card.Status}">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Info}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Subtle}" />
    </Style>

    <Style x:Key="Qul.Style.Card.Status.Warning" TargetType="Border" BasedOn="{StaticResource Qul.Style.Card.Status}">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Warning}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Warning}" />
    </Style>

    <Style x:Key="Qul.Style.Card.Status.Danger" TargetType="Border" BasedOn="{StaticResource Qul.Style.Card.Status}">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Danger}" />
    </Style>

    <Style x:Key="Qul.Style.Card.Status.Success" TargetType="Border" BasedOn="{StaticResource Qul.Style.Card.Status}">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Success}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Success}" />
    </Style>

    <!-- ================== 分割线 ================== -->
    <Style x:Key="Qul.Style.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Stroke.Subtle}" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================== 徽标（当前身份来源等） ================== -->
    <Style x:Key="Qul.Style.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Accent.Subtle}" />
        <Setter Property="CornerRadius" Value="{StaticResource Qul.Radius.Pill}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Qul.Style.Badge.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================== 图标（描边型） ================== -->
    <Style x:Key="Qul.Style.Icon" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{StaticResource Qul.Size.IconMedium}" />
        <Setter Property="Height" Value="{StaticResource Qul.Size.IconMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Qul.Style.Icon.Small" TargetType="Path" BasedOn="{StaticResource Qul.Style.Icon}">
        <Setter Property="Width" Value="{StaticResource Qul.Size.IconSmall}" />
        <Setter Property="Height" Value="{StaticResource Qul.Size.IconSmall}" />
    </Style>

</ResourceDictionary>
