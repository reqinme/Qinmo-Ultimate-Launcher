<!--
    Qul 按钮模板：四个层级。
      隐式 Button 样式  = 次按钮（Subtle）—— 未指定样式时就是它，避免出现系统默认外观
      Qul.Style.Button.Primary  主操作。**通常全场只有一个**；
                                唯一的例外是"有可用更新"时——更新卡片里的
                                「立即更新并重启」也用 Primary，与「启动游戏」同为填充层级。
                                为什么允许：那一瞬间确实有**两个都值得突出的动作**，
                                而它们分处两块区域、文案各自明确；把更新降级成隐式样式，
                                反而会让"有更新可用"这件事看起来不重要。
      Qul.Style.Button.Danger   危险操作
      Qul.Style.Button.Text     文本操作
      Qul.Style.Button.Icon     纯图标，正方形

    两条实现要点：
      1. 动效只用 Opacity 交叉淡化，不动 Background 颜色。
         颜色动画会走画刷重绘，Opacity 由合成器处理，后者便宜得多。
      2. 悬停底色通过 Tag 传递（Tag 在这里当"悬停画刷"用）。
         这是刻意的：WPF 没有第五个可模板绑定的画刷属性。
         使用点不要占用 Tag。

    焦点环同时改变描边粗细而不只是颜色 —— 色觉障碍用户也要看得见焦点在哪。
    纯图标按钮必须在使用点补 AutomationProperties.Name，否则读屏读到的是空。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:qul="clr-namespace:Qul.Presentation">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/QinmoUltimateLauncher;component/Presentation/Theme/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================= 模板（必须在引用它们的样式之前） ================= -->

    <!-- 次按钮骨架：悬停层用 Tag 上的画刷 -->
    <ControlTemplate x:Key="Qul.Template.Button.Base" TargetType="Button">
        <Grid>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Qul.Radius.Small}" />

            <Border x:Name="Hover"
                    Background="{TemplateBinding Tag}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Border x:Name="PressedLayer"
                    Background="{DynamicResource Qul.Brush.Surface.Inset}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Qul.Brush.Stroke.Focus}"
                    BorderThickness="{StaticResource Qul.Stroke.Focus}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{qul:Motion Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{qul:Motion Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0.55" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                <Setter TargetName="Hover" Property="Opacity" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 主按钮骨架：按下层用强调色的深色，不能沿用灰色内嵌底 -->
    <ControlTemplate x:Key="Qul.Template.Button.Primary" TargetType="Button">
        <Grid>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Qul.Radius.Small}" />

            <Border x:Name="Hover"
                    Background="{DynamicResource Qul.Brush.Accent.Hover}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Border x:Name="PressedLayer"
                    Background="{DynamicResource Qul.Brush.Accent.Pressed}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource Qul.Brush.Stroke.Focus}"
                    BorderThickness="{StaticResource Qul.Stroke.Focus}"
                    CornerRadius="{StaticResource Qul.Radius.Small}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{qul:Motion Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{qul:Motion Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                <Setter TargetName="Hover" Property="Opacity" Value="0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================= 样式 ================= -->

    <!-- 次按钮：隐式默认 -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Qul.Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Qul.Size.Font.Body}" />
        <Setter Property="Padding" Value="{StaticResource Qul.Thickness.Control}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Stroke.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Primary}" />
        <Setter Property="Tag" Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
        <Setter Property="Template" Value="{StaticResource Qul.Template.Button.Base}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Disabled}" />
                <Setter Property="Background" Value="{DynamicResource Qul.Brush.Surface.Inset}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 主操作：全场只有一个 -->
    <Style x:Key="Qul.Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Qul.Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.OnAccent}" />
        <Setter Property="Padding" Value="{StaticResource Qul.Thickness.ControlWide}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template" Value="{StaticResource Qul.Template.Button.Primary}" />
    </Style>

    <!-- 危险操作 -->
    <Style x:Key="Qul.Style.Button.Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Qul.Brush.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Danger}" />
        <Setter Property="Tag" Value="{DynamicResource Qul.Brush.Surface.Danger}" />
    </Style>

    <!-- 文本操作 -->
    <Style x:Key="Qul.Style.Button.Text" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Secondary}" />
        <Setter Property="Tag" Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- 纯图标 -->
    <Style x:Key="Qul.Style.Button.Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Qul.Brush.Text.Secondary}" />
        <Setter Property="Tag" Value="{DynamicResource Qul.Brush.Surface.RaisedHover}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

</ResourceDictionary>
