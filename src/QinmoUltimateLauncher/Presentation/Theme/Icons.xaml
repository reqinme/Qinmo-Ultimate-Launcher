<!--
    Qul 图标集：全部由本项目手写几何路径，24x24 网格。
    **不使用任何 Mojang / Minecraft 官方素材**，也不使用第三方图标库。

    约定：
      · 标注【描边】的按描边渲染（StrokeThickness 1.6，圆头圆角），默认前景色即线条色。
      · 标注【填充】的按填充渲染，用于强调形状（如播放三角）。
      · **本集合刻意保持最小：只保留界面真正在用的几何体。**
        未使用的资源与「有人想用却忘了」在文件里无法区分，所以不留备用——
        需要时按同样的格式补几行即可。

    用法：
      <Path Data="{StaticResource Qul.Icon.Refresh}" Stroke="{DynamicResource Qul.Brush.Text.Secondary}"
            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 品牌标识【描边】自制的 Q 字环，不使用任何官方标志 ===== -->
    <PathGeometry x:Key="Qul.Icon.Brand" Figures="M12,3.5 A8.5,8.5 0 1 0 12,20.5 A8.5,8.5 0 1 0 12,3.5 Z M15.4,15.4 L20.5,20.5" />

    <!-- ===== 操作 ===== -->
    <!-- 启动【填充】 -->
    <PathGeometry x:Key="Qul.Icon.Play" Figures="M9,5.5 L19,12 L9,18.5 Z" />
    <!-- 复制【描边】 -->
    <PathGeometry x:Key="Qul.Icon.Copy" Figures="M9,9 H19 V19 H9 Z M15,9 V5 H5 V15 H9" />
    <!-- 文件夹【描边】 -->
    <PathGeometry x:Key="Qul.Icon.Folder" Figures="M3.5,7.5 H10 L12,9.5 H20.5 V18.5 H3.5 Z" />
    <!-- 刷新【描边】 -->
    <PathGeometry x:Key="Qul.Icon.Refresh" Figures="M19,12 A7,7 0 1 1 12,5 M12,5 L12.2,2.2 M12,5 L14.8,5" />

    <!-- ===== 指示 ===== -->
    <PathGeometry x:Key="Qul.Icon.ChevronDown" Figures="M6.5,9.5 L12,15 L17.5,9.5" />
    <PathGeometry x:Key="Qul.Icon.Check" Figures="M5,12.5 L10,17.5 L19,7" />

    <!-- ===== 主题三态【描边】 ===== -->
    <PathGeometry x:Key="Qul.Icon.ThemeLight" Figures="M12,7.5 A4.5,4.5 0 1 0 12,16.5 A4.5,4.5 0 1 0 12,7.5 Z M12,2.5 V4.5 M12,19.5 V21.5 M2.5,12 H4.5 M19.5,12 H21.5 M5.3,5.3 L6.7,6.7 M17.3,17.3 L18.7,18.7 M18.7,5.3 L17.3,6.7 M6.7,17.3 L5.3,18.7" />
    <PathGeometry x:Key="Qul.Icon.ThemeDark" Figures="M20.5,14.5 A8.5,8.5 0 1 1 10,3.8 A6.8,6.8 0 0 0 20.5,14.5 Z" />
    <PathGeometry x:Key="Qul.Icon.ThemeSystem" Figures="M12,3.5 A8.5,8.5 0 1 0 12,20.5 A8.5,8.5 0 1 0 12,3.5 Z M12,3.5 V20.5" />

</ResourceDictionary>
