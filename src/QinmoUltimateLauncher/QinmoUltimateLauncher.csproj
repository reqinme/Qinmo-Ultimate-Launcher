<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Qinmo Launcher · 主程序
    技术方向（已定）：C# + WPF + net48，单文件、免安装、双击秒开、体积极小。
    net48 下必须显式指定 LangVersion，否则默认 C# 7.3 会让 Nullable 直接编译失败（CS8630）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 更新判定拿它跟发布清单比对，必须是个真实版本号 -->
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 应用图标：由本项目自制品牌标识生成，不使用任何外部素材 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!--
      版本信息不是装饰。一个没有产品名、没有厂商、没有版权声明的可执行文件，
      在用户眼里和在某些启发式眼里都更像可疑程序。
    -->
    <AssemblyTitle>Qinmo Ultimate Launcher</AssemblyTitle>
    <Product>Qinmo Ultimate Launcher</Product>
    <Company>Qinmo Ultimate Launcher</Company>
    <Description>Minecraft 启动器 · 单文件绿色版</Description>
    <Copyright>Copyright (C) Qinmo Ultimate Launcher · GPL-3.0</Copyright>
    <RootNamespace>Qul</RootNamespace>
    <AssemblyName>QinmoUltimateLauncher</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Qinmo Ultimate Launcher</Product>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 体积与产物整洁：去掉附属资源语言目录，输出目录不带 TFM 子层 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!--
    net48 的 SDK 风格工程不会自动带上压缩程序集，必须显式引用：
      System.IO.Compression          → ZipArchive / ZipArchiveEntry
      System.IO.Compression.FileSystem → ZipFile
    这两个是框架自带程序集，不构成第三方依赖，也不增加分发体积。
  -->
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
