{
  "name": "qinmo-ultimate-launcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "秦墨 · 通用启动器（前端外壳；业务逻辑一律在 Rust 侧）",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config web/vite.config.ts",
    "test:watch": "vitest --config web/vite.config.ts",
    "//verify:web": "一条命令跑完前端四件事。**顺序有意义**：typecheck 先跑（它最快、也最容易在重构中红），build 最后（它要 typecheck 过）。",
    "verify:web": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.12.1",
    "framer-motion": "^13.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "//": "pnpm 10 默认拦截依赖的构建脚本（防供应链投毒）。esbuild 是唯一确实需要的：它的 postinstall 只做一件事——把平台二进制链到正确位置。**白名单机制本身要保留**，将来引入带 postinstall 的依赖时应逐个评审，而不是图省事关掉整个限制。",
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
